{
  "version": "2.0.0",
  "tasks": [
    {
      // Build the plugin and copy it into the local Jellyfin plugins folder.
      // Configure the target instance via scripts/install-local.ps1 -JellyfinDataDir (defaults to
      // %LOCALAPPDATA%\jellyfin). Restart Jellyfin afterwards to load the new build.
      "label": "build-and-install",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/install-local.ps1",
        "-Configuration",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      // Build only (no install).
      "label": "build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Jellyfin.Plugin.ExternalRatings.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
